# ============================================================
# Lead Rescue AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Application ───────────────────────────────────────────
# Base URL of your application (no trailing slash)
# Development: http://localhost:3000
# Production:  https://yourdomain.com
APP_URL=http://localhost:3000

# ─── Authentication ────────────────────────────────────────
# Strong random secret for signing JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED — App will refuse to start in production without this.
JWT_SECRET=

# ─── Database ──────────────────────────────────────────────
# SQLite file path (relative to project root or absolute).
# For Turso Cloud: libsql://your-db-name.turso.io
# Default (leave empty): uses dev.db in project root
DATABASE_URL=

# ─── AI / OpenRouter ───────────────────────────────────────
# OpenRouter API key for real AI lead qualification.
# Get yours at https://openrouter.ai
# If not set, the built-in heuristic scoring engine is used automatically.
OPENROUTER_API_KEY=

# OpenRouter model to use (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Email / Resend ────────────────────────────────────────
# Resend API key for transactional emails (password reset, invitations, follow-ups).
# Get yours at https://resend.com
# If not set in development, email tokens are logged to the console.
RESEND_API_KEY=

# The "From" email address for system emails (must be a verified Resend sender domain)
EMAIL_FROM=noreply@yourdomain.com

# ─── Node Environment ──────────────────────────────────────
NODE_ENV=development
