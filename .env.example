# ============================================================
# Lead Rescue AI — Master Production Environment Variables
# Copy this file to .env.local (or set in Render / Hostinger / Vercel dashboard)
# NEVER commit real secret keys or .env files to version control.
# ============================================================

# ─── Application & Server Settings ──────────────────────────
# Environment: development | production | test
NODE_ENV=production

# Backend Server Express Port (default: 3001)
PORT=3001

# Primary Frontend Application Base URL (no trailing slash)
APP_URL=https://leadrescueai.xilxil.com

# Frontend Public API URL (Exposed to browser via NEXT_PUBLIC_ prefix — public safe URL only)
NEXT_PUBLIC_API_URL=https://lead-rescue-ai-backend.onrender.com

# Allowed CORS Origins (comma-separated for production frontend endpoints)
ALLOWED_ORIGINS=https://leadrescueai.xilxil.com,https://lead-rescue-ai-backend.onrender.com

# ─── Authentication & Security ──────────────────────────────
# REQUIRED in production. Strong 64-byte random secret for JWT signing & session verification.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# HMAC SHA-256 Secret Key for verifying inbound lead capture webhooks (/api/v1/webhooks/leads)
WEBHOOK_SECRET=your_webhook_signature_secret_here

# Verification token for Meta / WASender WhatsApp Webhook Handlers
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

# ─── Database Connection Strings ─────────────────────────────
# PostgreSQL Database URL (Supabase / Render / Neon PostgreSQL connection string)
# Connection pooler format: postgresql://postgres.ref:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# SQLite File Path fallback for local development (default: dev.db in project root)
DATABASE_URL=file:./dev.db

# ─── AI / OpenRouter Configuration ─────────────────────────
# OpenRouter API Key for AI lead qualification, scoring, and automated WhatsApp responses
# Get key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary OpenRouter AI model (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Email & Transactional Mailer (Resend) ─────────────────
# Resend API Key for sending invitations, password resets, and follow-ups
# Get key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Email Address (Domain must be verified in Resend dashboard)
EMAIL_FROM="Lead Rescue AI <notifications@leadrescue.ai>"

# ─── Stripe Payments (Server-Side Only) ─────────────────────
# Stripe Secret API Key (MUST NOT have NEXT_PUBLIC_ prefix — server-side only!)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Stripe Webhook Endpoint Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ─── Payoneer Payments (Server-Side Only) ────────────────────
PAYONEER_PROGRAM_ID=your_payoneer_program_id_here
PAYONEER_CLIENT_ID=your_payoneer_client_id_here
PAYONEER_CLIENT_SECRET=your_payoneer_client_secret_here

# ─── WASender WhatsApp Integration ─────────────────────────
WASENDER_API_KEY=your_wasender_api_key_here
WASENDER_DEVICE_ID=your_wasender_device_id_here
WASENDER_SESSION_NAME="My WhatsApp Session"

# ─── Twilio WhatsApp / SMS Integration ─────────────────────
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─── Supabase Client (Optional — Client/Server) ────────────
# Public Anon Key (Only exposed if Row Level Security is enabled on ALL Supabase tables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
